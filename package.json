{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start:api": "tsx server/index.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "org": "tsx --env-file-if-exists=.env scripts/org.ts",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-seed.ts --empty",
    "format:check": "oxfmt --check vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check:bundle": "tsx --env-file-if-exists=.env scripts/check-bundle.ts",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:e2e": "playwright test",
    "dataset:generate": "tsx tools/dataset/generate.ts datasets/synthetic/v1",
    "dataset:adverse": "python tools/dataset/adverse_fixtures.py",
    "dataset:export": "tsx tools/dataset/export.ts --source fixture",
    "qa:data": "python tools/qa/data_quality.py datasets/synthetic/v1",
    "qa:oracle": "python tools/qa/bi_oracle.py datasets/synthetic/v1 reports/evidence/bi_expected.json",
    "qa:perf": "tsx tools/qa/perf.ts reports/evidence/performance.json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.4"
  }
}
