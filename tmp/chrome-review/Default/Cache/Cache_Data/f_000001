const renderers={overview,direction,decisions,sales,clients,articles,stock,debts,margin,cash,orders,promos,scoring,packages,quality,extensions,coverage};async function render(){if(!renderers[state.page])state.page='overview';let s=sources[state.page];$('#title').textContent=pages.find(x=>x[0]===state.page)[1];$('#subtitle').textContent=s.scope+' - '+s.status;document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.page===state.page));$('#content').innerHTML='<div class="empty">Chargement...</div>';try{$('#content').innerHTML=await renderers[state.page]();bind()}catch(e){$('#content').innerHTML=`<div class="empty">Erreur de chargement: ${e.message}</div>`}}
