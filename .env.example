API_PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8443
UPLOAD_DIR=var/uploads
VITE_API_URL=/api/v1

# Authentication (required, no default).
#   oidc       identity provider; mandatory for any shared, staging or production server
#   local-dev  development identities, API bound to loopback and reachable from this machine only
AUTH_MODE=local-dev
# Bind address; loopback by default. Only containers/servers in AUTH_MODE=oidc use 0.0.0.0.
HOST=127.0.0.1
# local-dev only: identity requested by the browser in `npm run dev` (admin | manager-sfax |
# commercial-tunis). It is a name, not a credential; production builds ignore it.
VITE_DEV_IDENTITY=admin
# local-dev only, optional: fixed HS256 key (>= 32 chars) so sessions survive API restarts.
# AUTH_DEV_SIGNING_KEY=
# AUTH_MODE=oidc:
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=ai-negoce-api
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Token claim holding the organization (tenant) id; organizations are created with `npm run org`.
# OIDC_ORGANIZATION_CLAIM=org_id
# Organization allowed to read the synthetic SQLite ERP sandbox (default demo-fictive).
# ERP_SANDBOX_ORGANIZATION=demo-fictive
# Phase 2 opt-in: use pseudonymized Database/extractions in shared BI/DS/Agentic APIs.
# Only local-dev/test, never production. EUR/USD excluded from TND KPIs.
# DEMO_DATA_SOURCE=extractions
# One governed PostgreSQL snapshot shared by BI, Data Science and Agentic.
# The API fails closed when migrations or the tenant snapshot are missing.
UNIFIED_ANALYTICS_SOURCE=postgres


POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ai_negoce:change-me@127.0.0.1:5432/ai_negoce
# Unified three-dashboard demo: no ERP URL or token is required or used.
# The governed PostgreSQL snapshot above is the only connected analytics source.
# OCR_PROVIDER=http
# OCR_ENDPOINT=https://ocr.example.com/extract
# OCR_API_KEY=
# Gemini is called server-side only. Never prefix either secret with VITE_.
# GEMINI_API_KEY=           # Create in Google AI Studio
# AI_PROVIDER=gemini        # Supported alias for LLM_PROVIDER
# GEMINI_MODEL=gemini-2.5-flash # Supported alias for LLM_MODEL
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# LLM_PROVIDER_API_KEY=     # Optional generic alias for GEMINI_API_KEY
