API_PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8443
UPLOAD_DIR=var/uploads
VITE_API_URL=http://127.0.0.1:3001/api/v1

# Authentication (required, no default).
#   oidc       identity provider; mandatory for any shared, staging or production server
#   local-dev  development identities, API bound to loopback and reachable from this machine only
AUTH_MODE=local-dev
# Bind address; loopback by default. Only containers/servers in AUTH_MODE=oidc use 0.0.0.0.
HOST=127.0.0.1
# local-dev only: identity requested by the browser in `npm run dev` (admin | manager-sfax |
# commercial-tunis). It is a name, not a credential; production builds ignore it.
VITE_DEV_IDENTITY=admin
# local-dev only, optional: fixed HS256 key (>= 32 chars) so sessions survive API restarts.
# AUTH_DEV_SIGNING_KEY=
# AUTH_MODE=oidc:
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=ai-negoce-api
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ai_negoce:change-me@127.0.0.1:5432/ai_negoce
# ERP_BASE_URL=https://erp.example.com/api
# ERP_API_TOKEN=            # Never expose through VITE_ variables
# OCR_PROVIDER=http
# OCR_ENDPOINT=https://ocr.example.com/extract
# OCR_API_KEY=
# LLM_PROVIDER_API_KEY=     # Required before generative responses
